{
  "name": "vantinha-bot",
  "version": "1.0.0",
  "description": "Bot oficial do Vanta (Vantinha) baseado em Constatic, Discord Components V2, Firestore e Fastify API",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "build/index.js",
  "scripts": {
    "check": "tsc --noEmit && echo ✔ Ok",
    "build": "tsc",
    "dev": "node --watch-path=./src --watch --env-file=.env --import=tsx ./src/index.ts",
    "dev:dev": "node --watch-path=./src --watch --env-file=.env.dev --import=tsx ./src/index.ts",
    "watch": "node --watch-path=./src --watch --env-file=.env --import=tsx ./src/index.ts",
    "watch:dev": "node --watch-path=./src --watch --env-file=.env.dev --import=tsx ./src/index.ts",
    "start": "node --env-file=.env .",
    "start:dev": "node --env-file=.env.dev ."
  },
  "dependencies": {
    "@constatic/base": "^0.1.3",
    "@fastify/cors": "^10.0.1",
    "@magicyan/discord": "^1.7.5",
    "chalk": "^5.4.1",
    "discord.js": "^14.18.0",
    "fastify": "^5.2.1",
    "firebase-admin": "^12.7.0",
    "http-status-codes": "^2.3.0",
    "typesaurus": "^10.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "imports": {
    "#env": [
      "./build/env.js"
    ],
    "#base": [
      "./build/discord/index.js"
    ],
    "#functions": [
      "./build/functions/index.js"
    ],
    "#database": [
      "./build/database/index.js"
    ],
    "#server": [
      "./build/server/index.js"
    ],
    "#menus": [
      "./build/menus/index.js"
    ],
    "#tools": [
      "./build/tools/index.js"
    ],
    "#lib/*": [
      "./build/lib/*"
    ],
    "#shared/*": [
      "./build/shared/*"
    ]
  }
}
